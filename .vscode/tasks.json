{
  "version": "2.0.0",
  "tasks": [
    { "label": "Configure (CMake)", "type": "shell", "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release" },
    { "label": "Build", "type": "shell", "command": "cmake --build build --config Release", "dependsOn": "Configure (CMake)", "group": "build" },
    { "label": "Run tests", "type": "shell", "command": "ctest --test-dir build -C Release --output-on-failure", "dependsOn": "Build", "group": "test" }
  ]
}
